package-as: BobleLoot

# Libraries are vendored under Libs/ — do not let the packager pull
# them from external repos, just ship what's in this tree.

ignore:
  - .github
  - .editorconfig
  - .env
  - .env.example
  - .gitignore
  - .luacheckrc
  - .pkgmeta
  - README.md
  - bis
  - docs
  - tools
  - BobleLoot-*.zip
  - Data/BobleLoot_Data.lua

# Surface the changelog to the BigWigs packager so it shows on CurseForge.
changelog-title: BobleLoot

enable-nolib-creation: no
